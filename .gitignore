# Track only the maintained project, not the downloaded server/archive tree.
/*
!/.gitignore
!/.gitattributes
!/.gitleaks.toml
!/README.md
!/AGENTS.md
!/.github/
!/tools/
!/docs/
!/staging/

/staging/*
!/staging/wp-content/
/staging/wp-content/*
!/staging/wp-content/mu-plugins/
!/staging/wp-content/plugins/
!/staging/wp-content/ecwid-custom/
/staging/wp-content/mu-plugins/*
!/staging/wp-content/mu-plugins/ktk-*.php
!/staging/wp-content/mu-plugins/ktk-*-assets/
/staging/wp-content/plugins/*
!/staging/wp-content/plugins/ktk-storefront/

# Historical evidence stays in the local backup archive, not Git history.
# Only documentation and the immutable public inputs needed by builders follow.
/docs/**
!/docs/**/
!/docs/**/*.md
!/docs/seo/ROADMAP.html
/docs/commission-stripe-fees/**
/docs/clarity-journey-links/delivery/**
!/docs/homepage-parity/production-source-rendered-1920.html
!/docs/homepage-parity/production-source-styles-1920.json
!/docs/homepage-parity/parity-build.json
!/docs/code-pages/how-to-join/production-rendered-1920.html
!/docs/code-pages/how-to-join/production-styles-1920.json
!/docs/code-pages/how-to-join/build.json
!/docs/code-pages/full-migration/manifest.json
!/docs/code-pages/full-migration/assets.json
!/docs/code-pages/full-migration/build-report.json
!/docs/code-pages/full-migration/build-verification.json
!/docs/code-pages/full-migration/captures/*/production-1920.html
!/docs/code-pages/full-migration/captures/*/production-1920.json
!/docs/code-pages/full-migration/captures/*/production-390.json
!/docs/code-pages/production-readiness/production-seo-baseline.json
!/docs/homepage-seasonal-hero/source/Full Statue Final.ai
!/docs/seo/source/
!/docs/seo/source/**

# Local dependencies, histories and generated test output.
**/node_modules/
**/.history/
**/__pycache__/
**/*.py[cod]
**/.pytest_cache/
**/test-results/
**/playwright-report/
**/coverage/
**/.DS_Store
**/Thumbs.db
**/*.log
**/*.tmp
**/*.bak
**/*.zip
**/*.tar
**/*.gz
**/*.sql
**/*.sqlite*

# Secrets must never enter Git, including encrypted exports and browser state.
**/.env
**/.env.*
!**/.env.example
**/wp-config.php
**/*.pem
**/*.key
**/*.pfx
**/*.p12
**/*password*.xml
**/*credential*
**/storage-state*.json
**/storageState*.json
**/auth-state*.json

/docs/seo/preparation-inspection-profile-2026-11-18/local-calibration/
/docs/seo/preparation-inspection-profile-2026-11-18/ubuntu-calibration/
